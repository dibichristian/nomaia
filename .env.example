# Variables d'environnement de NOMAIA. Toutes sont facultatives.
# Memo uniquement : ce fichier n'est pas charge automatiquement. Definir les
# variables dans le shell, le service ou le raccourci de lancement.
# Les cles d'API (Anthropic, Gemini, Telegram, Odoo) ne vont PAS ici :
# elles se saisissent dans l'interface (Config) et sont chiffrees en base.

# Dossier des donnees (base, captures, sauvegardes, journal).
# Defaut : dossier du projet en developpement, %APPDATA%\NOMAIA en version installee.
NOMAIA_DATA_DIR=

# --- Serveur MCP (integrations/claude_mcp.py) ---
# Cle des sessions Claude, generee dans Config > Connexions > Sessions Claude.
NOMAIA_AGENT_KEY=
# Adresse de NOMAIA vue par le serveur MCP.
NOMAIA_URL=http://127.0.0.1:5555
